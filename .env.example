# Local secrets — gitignored. Fill before running Gemini ingest / Supabase.

# --- Gemini (Google AI Studio key — not a Replicate token) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
VERIFY_VISUAL_CROPS=true
# GEMINI_TIMEOUT_MS=120000
# GEMINI_MAX_OUTPUT_TOKENS=16384

# --- Google Drive MCP (Cursor) ---
# Place OAuth Desktop client JSON at: secrets/gdrive/gcp-oauth.keys.json
# Then run auth (once): see project notes / ask the agent to run the auth command.
# GDRIVE_OAUTH_PATH=secrets/gdrive/gcp-oauth.keys.json
# GDRIVE_CREDENTIALS_PATH=secrets/gdrive/credentials.json

# --- Kimi (Moonshot AI key for topic & Bloom's Taxonomy classification) ---
MOONSHOT_API_KEY=
# or KIMI_API_KEY=
# MOONSHOT_MODEL=kimi-k2.6
# MOONSHOT_TIMEOUT_S=120
# Optional overrides:
# MOONSHOT_API_URL=https://api.moonshot.ai/v1/chat/completions
# China region: MOONSHOT_API_URL=https://api.moonshot.cn/v1/chat/completions

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_QUESTIONS_BUCKET=questions

# --- PostgreSQL (Prisma) ---
# Supabase: Project Settings → Database → URI.
# Use the direct (non-pooler) connection for `prisma migrate`.
# --- Question Factory local storage (when Supabase Storage is unavailable) ---
# FACTORY_STORAGE_ROOT=output/factory-storage

# --- Layout Extraction and Drawing Snapping Thresholds ---
# Left margin boundary for identifying question number start locations (in PDF points)
QUESTION_NUM_LEFT_MARGIN_PTS=90.0
# Minimum Intersection over Union (IOU) for visual snapping
SNAP_MIN_IOU=0.08
# Maximum page area fraction a single graphic visual is allowed to occupy
SNAP_MAX_PAGE_FRAC=0.42

